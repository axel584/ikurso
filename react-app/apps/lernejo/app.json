{
  "expo": {
    "name": "iKurso",
    "slug": "lernejo",
    "scheme": "lernejo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.esperantofrance.ikurso"
    },
    "android": {
      "package": "org.esperantofrance.ikurso",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 4
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "lang": "fr"
    },
    "experiments": {
      "baseUrl": "/lernejo"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      "expo-font",
      "./plugins/subskribo",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#554E47"
        }
      ],
      "expo-sqlite"
    ]
  }
}
